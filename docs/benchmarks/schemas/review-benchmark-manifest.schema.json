{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kooiei-in4a/minimal-bank-system/docs/benchmarks/schemas/review-benchmark-manifest.schema.json",
  "title": "Independent Review Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "run_id", "target", "artifacts", "reviewers"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue", "pr", "base_sha", "head_sha"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "issue": { "type": "integer", "minimum": 1 },
        "pr": { "type": "integer", "minimum": 1 },
        "base_sha": { "$ref": "#/$defs/sha" },
        "head_sha": { "$ref": "#/$defs/sha" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "bytes", "sha256", "capture_status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "type": { "enum": ["raw_markdown", "structured_json", "gold_markdown", "gold_json", "run_identity", "summary", "full_evaluation", "other"] },
          "reviewer_slug": { "type": ["string", "null"] },
          "attempt": { "type": ["integer", "null"], "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "capture_status": { "enum": ["captured", "missing", "invalid"] }
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "model", "harness", "attempt", "outcome", "verdict"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "harness": { "type": "string", "minLength": 1 },
          "effort": { "type": ["string", "null"] },
          "attempt": { "type": "integer", "minimum": 1 },
          "outcome": { "enum": ["completed", "failed", "stopped", "wrong_target", "no_result"] },
          "verdict": { "enum": ["approve", "request_changes", "blocked", "incomplete", "not_applicable"] },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "tp": { "type": ["integer", "null"], "minimum": 0 },
          "fp": { "type": ["integer", "null"], "minimum": 0 },
          "fn": { "type": ["integer", "null"], "minimum": 0 },
          "markdown_path": { "type": ["string", "null"] },
          "json_path": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
