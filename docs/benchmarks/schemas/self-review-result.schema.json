{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kooiei-in4a/minimal-bank-system/docs/benchmarks/schemas/self-review-result.schema.json",
  "title": "Formal Self-Review Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "candidate",
    "h0",
    "reviewer",
    "attempt",
    "outcome",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "model",
        "harness"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "h0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head_sha"
      ],
      "properties": {
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "ci_run": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "harness",
        "fresh_context"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "fresh_context": {
          "type": "boolean"
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "stopped",
        "wrong_target",
        "no_result"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "blocking",
          "title",
          "description",
          "evidence",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SR-[0-9]{2,}$"
          },
          "severity": {
            "enum": [
              "Blocker",
              "Major",
              "Minor",
              "Nit"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "affected_component": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommended_fix": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
