    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MinimalBank.Domain\MinimalBank.Domain.csproj" />
    <ProjectReference Include="..\..\src\MinimalBank.Application\MinimalBank.Application.csproj" />
    <ProjectReference Include="..\..\src\MinimalBank.Infrastructure\MinimalBank.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MinimalBank.API\MinimalBank.API.csproj" />
  </ItemGroup>

</Project>