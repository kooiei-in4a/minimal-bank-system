<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core Tools requires the startup project to reference Design directly at
         design time; PrivateAssets=all keeps it out of the published Migrator output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MinimalBankSystem.Infrastructure/MinimalBankSystem.Infrastructure.csproj" />
  </ItemGroup>
</Project>
